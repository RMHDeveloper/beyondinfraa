# Database - Supabase PostgreSQL
# Transaction pooler (runtime queries - port 6543)
DATABASE_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:6543/postgres"
# Session pooler (migrations + seed - port 5432)
SESSION_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres"
# Direct connection
DIRECT_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"

# JWT — generate a long random secret for production, never reuse across environments
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Client-portal OTP
# OTP_DEV_BYPASS: if set, every OTP is fixed to this value instead of random.
# DEV/LOCAL USE ONLY — this is force-disabled outside NODE_ENV=development
# regardless of whether this var is set, so it is safe to leave unset in prod.
OTP_DEV_BYPASS=""
OTP_EXPIRY_MINUTES=5
# Firebase Admin SDK (server-side) — service account credentials
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Email (Gmail SMTP) — can also be configured at runtime via Settings > Email in the app
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BeyondInfra <noreply@beyondinfra.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Cron (required — cron routes reject all requests if this is unset)
CRON_SECRET="change-me"

# File storage (Hostinger — storage.php)
HOSTINGER_STORAGE_URL="https://beyondinfra.in/property-management-app/storage.php"
HOSTINGER_STORAGE_KEY=""
